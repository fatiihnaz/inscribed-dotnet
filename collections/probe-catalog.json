{
  "key": "probe-catalog",
  "allowAnonymousRead": true,
  "locales": ["tr", "en"],
  "slug": { "source": "AutoGenerated", "from": "name" },
  "fields": [
    { "name": "name", "type": "ShortText", "label": "Ad", "required": true, "sortable": true },
    { "name": "externalId", "type": "ShortText", "label": "Dış kayıt no", "required": true, "filterable": true, "help": "1-10 arası bir sayı yazın; enrichment o kaydı çeker." },
    { "name": "position", "type": "Number", "label": "Sıra", "sortable": true },
    { "name": "summary", "type": "LongText", "label": "Özet" }
  ],
  "enrich": [
    {
      "url": "https://jsonplaceholder.typicode.com/users/{externalId}",
      "cacheSeconds": 60,
      "map": {
        "contactName": { "path": "name", "type": "ShortText", "label": "İlgili kişi" },
        "contactEmail": { "path": "email", "type": "ShortText", "label": "E-posta" },
        "companyName": { "path": "company.name", "type": "ShortText", "label": "Şirket" },
        "companySite": { "path": "website", "type": "Url", "label": "Site" }
      }
    }
  ]
}

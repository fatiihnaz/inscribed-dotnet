# Copy to .env and fill in. .env is gitignored; never commit real secrets.

DB_PASSWORD=
CORS_ALLOWED_ORIGINS=https://your-spa.example.com

# Which identity provider issues tokens.
#   BuiltIn  = the bundled provider (Google login, refresh tokens, service keys)
#   External = your own OIDC provider; the bundled one is switched off entirely
AUTH_MODE=BuiltIn

# External mode only. AUTH_AUTHORITY points at the realm; AUTH_TENANT_CLAIM names the
# claim carrying the Inscribed client key. Set AUTH_REQUIRE_HTTPS_METADATA=false only
# when trialling against a plain-http provider.
#   AUTH_AUTHORITY=https://keycloak.example.com/realms/inscribed
#   AUTH_TENANT_CLAIM=tenant
#   AUTH_ROLES_CLAIM=roles
# Map provider role names onto Inscribed capabilities when they differ. Keys must not
# contain a colon: environment variables split nested keys on it.
#   Auth__RoleMap__cms-editor=content:write

# Production: keep ASPNETCORE_ENVIRONMENT=Production, set AUTH_ISSUER to the public
# HTTPS URL of this API (the app refuses to start with a localhost issuer in
# Production) and keep AUTH_COOKIE_SECURE=true.
# Local development: Development + http://localhost:5000 + AUTH_COOKIE_SECURE=false.
ASPNETCORE_ENVIRONMENT=Production
AUTH_ISSUER=https://cms.example.com
AUTH_COOKIE_SECURE=true

# BuiltIn mode only. Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI must be: <AUTH_ISSUER>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This e-mail receives service:admin on Google login without needing a membership.
# service:admin is installation-wide and cannot be granted per client; this list and the
# identity provider are the only sources.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Allowed login redirect origin for the seeded admin console client.
ADMIN_CONSOLE_ORIGIN=https://admin.example.com

# The API applies EF migrations on startup by default, which is fine for a single
# instance. For multi-instance deploys set this to false and apply migrations as a
# one-shot before rolling out replicas:
#   docker compose --profile migrate run --rm api-migrate
# With it false, an instance refuses to start if the schema is behind.
DB_MIGRATE_ON_STARTUP=true